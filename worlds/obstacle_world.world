    <!-- ═══════════════════════════════════════════════════════════
         BOLLARDS — at the entrance
    ═══════════════════════════════════════════════════════════ -->
    <model name="bollard_1">
      <static>true</static>
      <pose>9 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.5</length></cylinder></geometry>
          <material>
