<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="parking_lot">

    <!-- ═══════════════════════════════════════════════════════════
         PHYSICS & ENVIRONMENT
         Parking lot: 20m x 16m, origin at centre (0,0)
         Driving lane: 2.5m wide along y=0
         Robot spawns at east entrance (x=8.5, y=0)
    ═══════════════════════════════════════════════════════════ -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- GROUND PLANE -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         OUTER BOUNDARY WALLS
         Parking lot is 20m x 16m
         Origin at centre (0,0)
    ═══════════════════════════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 16 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall north segment: from y=2 to y=8, length=6, centre y=5 -->
    <model name="wall_east_north">
      <static>true</static>
      <pose>10 5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall south segment: from y=-8 to y=-2, length=6, centre y=-5 -->
    <model name="wall_east_south">
      <static>true</static>
      <pose>10 -5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 0.8</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/Grey</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         PARKING DIVIDER — centre island separating two rows
    ═══════════════════════════════════════════════════════════ -->
    <model name="divider_west">
      <static>true</static>
      <pose>-2.5 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9 0.15 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 0.15 0.2</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/White</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="divider_east">
      <static>true</static>
      <pose>6 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 0.2</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <n>Gazebo/White</n>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         PARKED CARS — NORTH ROW  (y=+4)
         Each car: 1.8m wide, 0.9m tall, 3.6m long
    ═══════════════════════════════════════════════════════════ -->

    <model name="car_n1">
      <static>true</static>
      <pose>-8 4 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 3.6 0.9</size></box></geometry>
