    <!-- ═══════════════════════════════════════════════════════════
         SPEED BUMPS — in the driving lane
    ═══════════════════════════════════════════════════════════ -->
    <model name="speed_bump_1">
      <static>true</static>
      <pose>-6 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.4 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.4 0.08</size></box></geometry>
          <material>
