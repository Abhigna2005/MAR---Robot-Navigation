    <model name="speed_bump_2">
      <static>true</static>
      <pose>2 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.4 0.08</size></box></geometry>
        </collision>
