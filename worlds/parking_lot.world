<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="parking_lot">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- GROUND -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NORTH WALL -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SOUTH WALL -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WEST WALL -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 16 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- EAST WALL NORTH -->
    <model name="wall_east_north">
      <static>true</static>
      <pose>10 5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
