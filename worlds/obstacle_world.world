    <!-- car_s4 intentionally missing — empty parking spot for robot goal -->

    <model name="car_s5">
      <static>true</static>
      <pose>4 -4 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 3.6 0.9</size></box></geometry>
